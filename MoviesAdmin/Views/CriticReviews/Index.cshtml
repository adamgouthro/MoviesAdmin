@model IEnumerable<MoviesAdmin.Models.CriticReview>

@{
    ViewData["Title"] = "Index";
}

<h1>My Reviews</h1>

<p>
    <a asp-action="Create">Add New Review</a>
</p>
<table class="table table-bordered mx-auto table-bg-transparent border-black">
    <thead>
        <tr>
            <th class="px-2 text-center align-content-center">
                @Html.DisplayNameFor(model => model.MovieId)
            </th>
            <th class="px-2 text-center align-content-center">
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th class="px-2 text-center align-content-center">
                @Html.DisplayNameFor(model => model.Rating)
            </th>
            <th class="px-2 text-center align-content-center">
                @Html.DisplayNameFor(model => model.IsPublished)
            </th>
            <th class="px-2 text-center align-content-center">
                @Html.DisplayNameFor(model => model.CreatedBy)
            </th>
            <th class="px-2 text-center align-content-center">
                @Html.DisplayNameFor(model => model.CreatedDate)
            </th>
            <th class="px-2 text-center align-content-center">Options</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td class="px-2 text-center align-content-center">
                @Html.DisplayFor(model => item.MovieId)
            </td>
            <td class="px-2 text-center align-content-center">
                @Html.DisplayFor(model => item.Description)
            </td>
            <td class="px-2 text-center align-content-center">
                @Html.DisplayFor(model => item.Rating)
            </td>
            <td class="px-2 text-center align-content-center">
                @Html.DisplayFor(model => item.IsPublished)
            </td>
            <td class="px-2 text-center align-content-center">
                @Html.DisplayFor(model => item.CreatedBy)
            </td>
            <td class="px-2 text-center align-content-center"> 
                @Html.DisplayFor(model => item.CreatedDate)
            </td>
            <td class="px-2 text-center align-content-center">
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
