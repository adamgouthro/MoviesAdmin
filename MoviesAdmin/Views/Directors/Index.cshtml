@model IEnumerable<MoviesAdmin.Models.Director>

@{
    ViewData["Title"] = "Index";
}

<h1>Directors</h1>
<hr />
@if (User.IsInRole("administrator"))
{
    <p>
        <a asp-action="Create">Add New Director</a>
    </p>
}

@* Source -> https://learn.microsoft.com/en-us/aspnet/core/tutorials/first-mvc-app/search?view=aspnetcore-10.0 *@ 
<form asp-controller="Directors" asp-action="Index">
    <p>
        <input type="text" name="SearchString" />
        <input type="submit" value="Search" class="bg-primary text-white border-0 rounded" />
    </p>
</form>

<table class="table table-bordered mx-auto table-bg-transparent border-black">
    <thead >
        <tr>
            <th class="px-2 text-center align-content-center">
                @Html.DisplayNameFor(model => model.Movies)
            </th>
            <th class="px-2 text-center align-content-center">
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th class="px-2 text-center align-content-center">
                @Html.DisplayNameFor(model => model.Birthday)
            </th>
            <th class="px-2 text-center align-content-center">
                @Html.DisplayNameFor(model => model.Birthplace)
            </th>
            <th class="px-2 text-center align-content-center">Options</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td class="px-2 text-center align-content-center">
                <img src="@item.ImageUrl" alt="@item.Name" class="thumbnail" />
            </td>
            <td class="px-2 text-center align-content-center">
                @Html.DisplayFor(model => item.Name)
            </td>
            <td class="px-2 text-center align-content-center">
                @Html.DisplayFor(model => item.Birthday)
            </td>
            <td class="px-2 text-center align-content-center">
                @Html.DisplayFor(model => item.Birthplace)
            </td>
            <td class="px-2 text-center align-content-center">
                @if (User.IsInRole("administrator"))
                {
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> 
                }
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> 
                @if (User.IsInRole("administrator"))
                {
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                }
            </td>
        </tr>
}
    </tbody>
</table>
