@model MoviesAdmin.Models.Movie
@using Microsoft.AspNetCore.Html

@{
    ViewData["Title"] = "Details";
}

<h1>@Html.DisplayFor(model => model.Title)</h1>

<div>
    <hr />

    <div class="mb-3">
        <img src="@Model.ImageUrl" alt="@Model.Title" class="detail-image-sizing" />
    </div>

    <dl>
        @* <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Title)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Title)
        </dd> *@


        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Synopsis)
        </dt>
        <dd class="col-sm-10">
            @{
                var synopsisWithBreaks = new HtmlString(
                    Model.Synopsis.Replace("\r\n", "<br />")
                        .Replace("\n", "<br />")
                        .Replace("\r", "<br />"));

            }

            @synopsisWithBreaks
        </dd>

        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.GenreId)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Genre.Title)
        </dd>

        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.AudienceRatingId)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Rating.Title)
        </dd>

        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Runtime)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Runtime)
        </dd>
 
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ReleaseDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ReleaseDate)
        </dd>

        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.DirectorId)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Director.Name)
        </dd>
        <dt class = "col-sm-2">
            Total Reviews:
        </dt>
        <dd class = "col-sm-10">
            @ViewBag.ReviewCount
        </dd>
    </dl>
</div>

<div class="row">
    <div class="d-flex gap-3">
    @if (User.IsInRole("administrator")) 
    {
        <a asp-action="Edit" asp-route-id="@Model?.Id" class="me-3">Edit</a> 
    }
    @if (User.IsInRole("critic") && !Model.CriticReviews.Any(c => c.CreatedBy == ViewBag.UserId && c.IsPublished))
    {
         <a asp-controller="CriticReviews" asp-action="Create" asp-route-movieId="@Model?.Id" class="me-3">Add Review</a>
    }
    <a asp-action="Index">Back to List</a>
    </div>
</div>
