@model IEnumerable<MoviesAdmin.Models.Movie>

@{
    ViewData["Title"] = "Index";
}

<h1>Movies</h1>
<hr />

@if (User.IsInRole("administrator"))
{
    <p>
        <a asp-action="Create">Add New Movie</a>
    </p>
}

@* Source -> https://learn.microsoft.com/en-us/aspnet/core/tutorials/first-mvc-app/search?view=aspnetcore-10.0 *@ 
<form asp-controller="Movies" asp-action="Index">
    <p>
        <input type="text" name="SearchString" />
        <input type="submit" value="Search" class="bg-primary text-white border-0 rounded" />
    </p>
</form>

<table class="table table-bordered mx-auto table-bg-transparent border-black">
    <thead>
        <tr>
            <th class="px-2 text-center align-content-center">
                Movie Poster
            </th>
            <th class="px-2 text-center align-content-center">
                @Html.DisplayNameFor(model => model.Title)
            </th>
            @* <th>
                @Html.DisplayNameFor(model => model.Synopsis) // Hidden
            </th> *@
            <th class="px-2 text-center align-content-center">
                @Html.DisplayNameFor(model => model.GenreId)
            </th>
            <th class="px-2 text-center align-content-center">
                @Html.DisplayNameFor(model => model.AudienceRatingId)
            </th>
            <th class="px-2 text-center align-content-center">
                @Html.DisplayNameFor(model => model.Runtime)
            </th>
            <th class="px-2 text-center align-content-center">
                @Html.DisplayNameFor(model => model.ReleaseDate)
            </th>
            @* <th>
                @Html.DisplayNameFor(model => model.CreatedDate) // Hidden
            </th> *@
            <th class="px-2 text-center align-content-center">
                @Html.DisplayNameFor(model => model.DirectorId)
            </th>
            <th class="px-2 text-center align-content-center">
                Options
            </th>
        </tr>
    </thead> 
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td class="px-2 text-center align-content-center">
                <img src="@item.ImageUrl" alt="@item.Title" class="thumbnail" />
            </td>
            <td class="px-2 text-center align-content-center">
                @Html.DisplayFor(model => item.Title)
            </td>
            @* <td>
                @Html.DisplayFor(model => item.Synopsis) // Hidden
            </td> *@
                <td class="px-2 text-center align-content-center">
                @Html.DisplayFor(model => item.Genre.Title)
            </td>
            <td class="px-2 text-center align-content-center">
                @Html.DisplayFor(model => item.Rating.Title)
            </td>
            <td class="px-2 text-center align-content-center">
                @Html.DisplayFor(model => item.Runtime)
            </td>
            <td class="px-2 text-center align-content-center">
                @Html.DisplayFor(model => item.ReleaseDate)
            </td>
            @* <td>
                @Html.DisplayFor(model => item.CreatedDate) // Hidden
            </td> *@
            <td class="px-2 text-center align-content-center">
                @Html.DisplayFor(model => item.Director.Name)
            </td>
            <td class="px-2 text-center align-content-center">
                @if (User.IsInRole("administrator"))
                {
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> 
                }
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> 
                @if (User.IsInRole("administrator"))
                {
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                }
            </td>
        </tr>
}
    </tbody>
</table>
