@model IEnumerable<MoviesAdmin.Models.Movie>

@{
    ViewData["Title"] = "Index";
}

<h1>Movies</h1>
<hr />

<p>
    <a asp-action="Create">Add New Movie</a>
</p>
<table class="table-bordered">
    <thead>
        <tr>
            <th class="px-2 text-center">
                @Html.DisplayNameFor(model => model.Title)
            </th>
            @* <th>
                @Html.DisplayNameFor(model => model.Synopsis) // Make it cleaner
            </th> *@
            <th class="px-2 text-center">
                @Html.DisplayNameFor(model => model.Genre)
            </th>
            <th class="px-2 text-center">
                @Html.DisplayNameFor(model => model.Rating)
            </th>
            <th class="px-2 text-center">
                @Html.DisplayNameFor(model => model.Runtime)
            </th>
            <th class="px-2 text-center">
                @Html.DisplayNameFor(model => model.ReleaseDate)
            </th>
            @* <th>
                @Html.DisplayNameFor(model => model.CreatedDate) // They dont need to see the created date
            </th> *@
            <th class="px-2 text-center">
                @Html.DisplayNameFor(model => model.Director)
            </th>
            <th class="px-2 text-center">
                @Html.DisplayNameFor(model => model.MovieStudio)
            </th>
            <th class="px-2 text-center">
                @Html.DisplayNameFor(model => model.Screenwriter)
            </th>
            <th class="px-2 text-center">
                @Html.DisplayNameFor(model => model.Distributor)
            </th>
            <th class="px-2 text-center">
                Options
            </th>
        </tr>
    </thead> 
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td class="px-2 text-center">
                @Html.DisplayFor(model => item.Title)
            </td>
            @* <td>
                @Html.DisplayFor(model => item.Synopsis)
            </td> *@
            <td class="px-2 text-center">
                @Html.DisplayFor(model => item.Genre)
            </td>
            <td class="px-2 text-center">
                @Html.DisplayFor(model => item.Rating)
            </td>
            <td class="px-2 text-center">
                @Html.DisplayFor(model => item.Runtime)
            </td>
            <td class="px-2 text-center">
                @Html.DisplayFor(model => item.ReleaseDate)
            </td>
            @* <td>
                @Html.DisplayFor(model => item.CreatedDate)
            </td> *@
            <td class="px-2 text-center">
                @Html.DisplayFor(model => item.Director)
            </td>
            <td class="px-2 text-center">
                @Html.DisplayFor(model => item.MovieStudio)
            </td>
            <td class="px-2 text-center">
                @Html.DisplayFor(model => item.Screenwriter)
            </td>
            <td class="px-2 text-center">
                @Html.DisplayFor(model => item.Distributor)
            </td>
            <td class="px-2 text-center">
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> 
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> 
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
